# =============================================================================
# PGEA — Plataforma de Gestión de Eventos Académicos
# Plantilla de variables de entorno. Copiar a .env y completar los secretos.
#   cp .env.example .env
# NUNCA commitear el archivo .env real (está en .gitignore).
# En la VM Lightsail: archivo .env con permisos 600. En CI: GitHub secrets.
# =============================================================================

# ---- Entorno -----------------------------------------------------------------
# dev | stage | prod  (controla logging, recarga y comportamiento de adaptadores)
ENV=dev

# ---- Base de datos (PostgreSQL 16 + pgvector) --------------------------------
POSTGRES_USER=pgea_app_user
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=pgea
# Host 'postgres' = nombre del servicio en docker-compose.
DATABASE_URL=postgresql+asyncpg://pgea_app_user:change_me_in_local_env@postgres:5432/pgea

# ---- Seguridad / Autenticación (ADR-06) --------------------------------------
# JWT propio HS256. Generar uno fuerte:  openssl rand -hex 32
JWT_SECRET=change_me_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440      # 24h
REFRESH_TOKEN_EXPIRE_DAYS=7

# SSO delegado (OAuth 2.0 / OpenID Connect). En el POC: adaptador mock.
# oauth_provider: mock | google
OAUTH_PROVIDER=mock
OAUTH_CLIENT_ID=pgea-mock-client
OAUTH_CLIENT_SECRET=pgea-mock-secret

# ---- Pasarela de pagos (RF-04) -----------------------------------------------
# payment_provider: mock | real
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_KEY=pgea-mock-payment-key
PAYMENT_RESERVATION_TIMEOUT_MINUTES=15   # RN-06

# ---- Proveedor de correo (ADR-03, RNF-15) ------------------------------------
# email_provider: mock | smtp
EMAIL_PROVIDER=mock
EMAIL_FROM=eventos@javeriana.edu.co
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_RATE_LIMIT_PER_SECOND=10           # RN-08

# ---- Embeddings / Búsqueda semántica (RF-30, ADR-07) -------------------------
# embedding_provider: openai | fake
#   openai -> text-embedding-3-small con dimensions=384 (usa OPENAI_API_KEY)
#   fake   -> embeddings deterministas (tests/CI, sin costo de API)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384
OPENAI_API_KEY=sk-REEMPLAZAR_EN_ENV_LOCAL

# ---- Observabilidad (OpenTelemetry + Prometheus + Loki + Tempo) --------------
SERVICE_NAME=pgea-api
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
LOKI_ENDPOINT=http://loki:3100/loki/api/v1/push
LOG_LEVEL=INFO

# ---- Worker ------------------------------------------------------------------
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_MAX_RETRIES=5

# ---- Frontend (build-time, inyectado por Vite) -------------------------------
# En despliegue por Nginx el frontend llama a /api (mismo origen).
VITE_API_BASE_URL=/api
